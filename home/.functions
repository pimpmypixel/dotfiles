# Run tests
function p() {
   if [ -f vendor/bin/pest ]; then
      vendor/bin/pest "$@"
   else
      vendor/bin/phpunit "$@"
   fi
}

function pf() {
   if [ -f vendor/bin/pest ]; then
      vendor/bin/pest --filter "$@"
   else
      vendor/bin/phpunit --filter "$@"
   fi
}

# Create a new directory and enter it
function mkd() {
   mkdir -p "$@" && cd "$@"
}

# All the dig info
function digga() {
	dig +nocmd "$1" any +multiline +noall +answer
}

function removehost() {
   ssh-keygen -R "$1"
}

#  Commit everything
function commit() {
  commitMessage="$*"

  git add .

  is_wip=0
  if [ "$commitMessage" = "wip" ]; then
    is_wip=1
    commitMessage=""
  fi

  if [ "$commitMessage" = "" ]; then
      # Start spinner in background (suppress job control messages)
      {
        spinner="⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
        while true; do
          for (( i=0; i<${#spinner}; i++ )); do
            printf "\r${spinner:$i:1} Generating commit message..."
            sleep 0.1
          done
        done
      } &!
      spinner_pid=$!

      # Cleanup function for interrupt
      cleanup() {
        { kill $spinner_pid; wait $spinner_pid; } 2>/dev/null
        printf "\r\033[K"
        trap - INT
        return 1
      }
      trap cleanup INT

      # Get diff with size limit, include stat summary for context
      diff_input=$(echo "=== Summary ===" && git diff --cached --stat && echo -e "\n=== Diff (truncated if large) ===" && git diff --cached | head -c 50000)
      generatedMessage=$(echo "$diff_input" | claude -p --no-session-persistence "Write a single-line commit message for this diff. Output ONLY the message, no quotes, no explanation, no markdown.")

      # Stop spinner and clear line
      trap - INT
      { kill $spinner_pid; wait $spinner_pid; } 2>/dev/null
      printf "\r\033[K"

      if echo "$generatedMessage" | grep -q "You've hit your limit"; then
        echo "API limit reached. Please enter your commit message:"
        read -r commitMessage
      else
        if [ "$is_wip" = "1" ]; then
          commitMessage="WIP: $generatedMessage"
        else
          commitMessage="$generatedMessage"
        fi
      fi

      git commit -m "$commitMessage"
      return
   fi

   eval "git commit -a -m '${commitMessage}'"
}

function db() {
    case "$1" in
        refresh)
            mysql -uroot -e "drop database $2; create database $2"
            ;;
        create)
            mysql -uroot -e "create database $2"
            ;;
        drop)
            mysql -uroot -e "drop database $2"
            ;;
        list)
            mysql -uroot -e "show databases" | sed 's/[|[:space:]]//g'
            ;;
        *)
            echo "Usage: db {refresh|create|drop|list} [database_name]"
            return 1
            ;;
    esac
}

function scheduler() {
   while :; do
      php artisan schedule:run
      echo "Sleeping 60 seconds..."
      sleep 60
   done
}

function claude-yolo() {
  claude --dangerously-skip-permissions "$@"
}

function git-prune-local() {
  git fetch -p && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs git branch -D
}

function clone() {
  gh repo clone "$1" "${@:2}"
}

function gbump() {
  local level=${1:-patch}
  if [[ ! "$level" =~ ^(major|minor|patch)$ ]]; then
    echo "Usage: gbump {major|minor|patch}"
    return 1
  fi

  # Fetch tags so local refs aren't stale, then find the highest by version sort
  git fetch --tags --quiet
  local latest_tag=$(git tag -l 'v*' | sort -V | tail -1 | sed 's/^v//')
  if [[ -z "$latest_tag" ]]; then
    echo "No tags in repo."
    return 1
  fi

  # Parse major, minor, patch
  IFS='.' read -r major minor patch <<< "$latest_tag"

  case "$level" in
    major)
      major=$((major + 1))
      minor=0
      patch=0
      ;;
    minor)
      minor=$((minor + 1))
      patch=0
      ;;
    patch)
      patch=$((patch + 1))
      ;;
  esac

  local new_tag="$major.$minor.$patch"

  # Check if tag already exists
  if git rev-parse "v$new_tag" >/dev/null 2>&1; then
    echo "Tag v$new_tag already exists."
    return 1
  fi

  # Create annotated tag and push
  git tag -a "v$new_tag" -m "Bump $level version to v$new_tag"
  git push origin "v$new_tag"

  echo "Bumped to v$new_tag"
}
